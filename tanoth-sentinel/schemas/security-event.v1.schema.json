{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tanothlegends3d.invalid/schemas/security-event.v1.schema.json",
  "title": "Tanoth Sentinel Security Event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "schemaVersion", "eventId", "environment", "severity",
    "ruleCode", "realm", "actorId", "sessionId", "build", "apiVersion",
    "occurredAt", "summary", "source", "context", "fingerprint"
  ],
  "properties": {
    "schema": { "const": "tanoth.security.event" },
    "schemaVersion": { "const": 1 },
    "eventId": { "type": "string", "minLength": 8, "maxLength": 96, "pattern": "^[A-Za-z0-9._-]+$" },
    "environment": { "enum": ["DEV", "LIVE"] },
    "severity": { "enum": ["INFO", "WARN", "HIGH", "CRITICAL"] },
    "ruleCode": { "type": "string", "minLength": 3, "maxLength": 80, "pattern": "^[A-Z0-9._-]+$" },
    "realm": { "type": "string", "minLength": 1, "maxLength": 80 },
    "actorId": { "type": "string", "minLength": 8, "maxLength": 96 },
    "sessionId": { "type": "string", "minLength": 8, "maxLength": 96 },
    "build": { "type": "string", "minLength": 1, "maxLength": 80 },
    "apiVersion": { "type": "integer", "minimum": 1 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "summary": { "type": "string", "minLength": 1, "maxLength": 240 },
    "source": { "type": "string", "minLength": 1, "maxLength": 40 },
    "context": { "type": "object", "maxProperties": 24 },
    "recentSteps": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["at", "name"],
        "properties": {
          "at": { "type": "integer", "minimum": 0 },
          "name": { "type": "string", "maxLength": 80 }
        }
      }
    },
    "fingerprint": { "type": "string", "minLength": 6, "maxLength": 80 },
    "status": { "enum": ["new", "repeated", "resolved"] },
    "count": { "type": "integer", "minimum": 1 },
    "firstSeenAt": { "type": "integer", "minimum": 0 },
    "lastSeenAt": { "type": "integer", "minimum": 0 },
    "resolvedAt": { "type": "integer", "minimum": 0 },
    "attempts": { "type": "integer", "minimum": 0, "maximum": 9 },
    "nextAttemptAt": { "type": "integer", "minimum": 0 },
    "lastTransportError": { "type": "string", "maxLength": 80 }
  }
}

